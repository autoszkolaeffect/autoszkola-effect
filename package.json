{
	"name": "autoszkola-effect",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev --mode dev",
		"build": "vite build --mode prod",
		"preview": "vite preview --mode prod",
		"prepare": "svelte-kit sync || echo ''",
		"messages": "node scripts/compile-messages.mjs",
		"check": "npm run messages && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "npm run messages && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:migrate:prod": "node --env-file=.env.prod node_modules/drizzle-kit/bin.cjs migrate",
		"db:studio": "drizzle-kit studio",
		"db:seed": "node --env-file=.env.dev seed/seed.mjs",
		"db:seed:prod": "node --env-file=.env.prod seed/seed.mjs",
		"db:seed:content": "node --env-file=.env.dev seed/content.mjs",
		"db:seed:content:prod": "node --env-file=.env.prod seed/content.mjs",
		"auth:schema": "auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^2.18.2",
		"@sveltejs/adapter-vercel": "^7.0.0-next.9",
		"@sveltejs/kit": "next",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/markdown-it": "^14.2.0",
		"@types/node": "^24",
		"@types/nodemailer": "^8.0.1",
		"auth": "^1.6.23",
		"better-auth": "^1.6.23",
		"carta-md": "^4.11.2",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"markdown-it": "^14.3.1",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"valibot": "^1.5.0",
		"vite": "^8.0.16"
	},
	"overrides": {
		"better-auth": {
			"@sveltejs/kit": "$@sveltejs/kit"
		}
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@lucide/svelte": "^1.44.0",
		"@resvg/resvg-js": "^2.6.2",
		"nodemailer": "^10.0.3",
		"satori": "0.32.0"
	}
}
