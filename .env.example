# Copy this file to .env.dev (local + Vercel preview) and .env.prod (Vercel),
# then fill in the blanks. Both copies are gitignored; this template is the only
# env file that is committed, so it must never contain real values.
#
#   cp .env.example .env.dev
#   cp .env.example .env.prod
#
# The app is hosted on Vercel, which cannot use Cloudflare Workers bindings, so
# D1 is reached over its REST API. That means ACCOUNT_ID + DATABASE_ID + D1_TOKEN
# are all required at runtime, not just for migrations.
#
# On Vercel itself these are set as project environment variables
# (Settings -> Environment Variables, or `vercel env add`), not from a file.

# ============================ public ============================

# No trailing slash.
#   dev  -> http://localhost:5173
#   prod -> https://<your-project>.vercel.app
ORIGIN=''

# Cloudflare dashboard sidebar on any Workers page, or: npx wrangler whoami
CLOUDFLARE_ACCOUNT_ID=''

# Which D1 database this env points at. Reference only - nothing reads it.
#   dev  -> autoszkola-effect-dev
#   prod -> autoszkola-effect-prod
CLOUDFLARE_DATABASE_NAME=''

# Storage & Databases -> D1 -> your database -> "Database ID"
#   dev  -> da15e18f-6bbf-4eb5-8cab-c4663a342b0d
#   prod -> 20adbc4f-9a3d-4c95-b99f-80e0ead0ba8d
CLOUDFLARE_DATABASE_ID=''

# ============================ secret ============================

# Cloudflare dashboard -> My Profile -> API Tokens -> Create Token
# -> Custom token, permissions: Account | D1 | Edit.
# D1:Read is not enough - better-auth writes. Shown once, copy it immediately.
CLOUDFLARE_D1_TOKEN=''

# Use a DIFFERENT value per environment. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=''

# dash.cloudflare.com -> Turnstile -> your widget. The site key is rendered into
# the contact form (public by design); the secret key never leaves the server.
TURNSTILE_SITE_KEY=''
TURNSTILE_SECRET_KEY=''

# Encrypts secrets the admin panel writes to the database (the SMTP password).
# Use a DIFFERENT value per environment. Rotating it makes the stored SMTP
# password unreadable, so re-enter it in the admin panel afterwards. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SETTINGS_ENCRYPTION_KEY=''
